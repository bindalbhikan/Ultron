{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ultron-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8788",
    "AUTH_BASE_URL": "https://ultron-app-api.bhikan-serein.workers.dev",
    "WORKER_URL": "https://bindal-telegram-bot.bhikan-serein.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ultron",
      "database_id": "8b95a6a1-f6ac-45ed-adcd-a545914c03b2",
      "migrations_dir": "migrations"
    }
  ]
}
