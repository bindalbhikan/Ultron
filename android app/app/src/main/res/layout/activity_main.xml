<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultron Phone"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bindal agent's phone: Myntra lookups and SMS to sheet"
                android:textColor="@color/accent_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <!-- status + agent switch -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/agentDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot" />

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Agent mode" />

                    <Switch
                        android:id="@+id/agentSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/agentText"
                    style="@style/Label"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Label"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- agent settings -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="Agent connection" />

                <TextView style="@style/Label" android:text="Worker URL" />
                <EditText
                    android:id="@+id/workerInput"
                    style="@style/Field"
                    android:hint="https://bindal-telegram-bot.….workers.dev"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:text="Token (the worker's DASHBOARD_TOKEN)" />
                <EditText
                    android:id="@+id/tokenInput"
                    style="@style/Field"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- sms to sheet -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="SMS to sheet" />

                <TextView style="@style/Label" android:text="Apps Script web app URL (/exec)" />
                <EditText
                    android:id="@+id/urlInput"
                    style="@style/Field"
                    android:hint="https://script.google.com/macros/s/…/exec"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:text="Secret key (same as in Apps Script)" />
                <EditText
                    android:id="@+id/secretInput"
                    style="@style/Field"
                    android:inputType="textPassword" />

                <TextView style="@style/Label" android:text="Senders (comma separated, empty = all)" />
                <EditText
                    android:id="@+id/filterInput"
                    style="@style/Field"
                    android:hint="MYNTRA, DELHIVERY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/permissionButton"
                        style="@style/Action"
                        android:text="Allow SMS" />

                    <Button
                        android:id="@+id/testButton"
                        style="@style/Action"
                        android:text="Send test row" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/accent"
                android:text="Save settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

            <!-- phone setup -->
            <LinearLayout style="@style/Card">

                <TextView style="@style/CardTitle" android:text="Phone setup" />

                <TextView
                    style="@style/Label"
                    android:text="Keep the agent alive: turn battery optimisation off for this app, and on Xiaomi / Oppo / Vivo / Realme turn Autostart on." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/batteryButton"
                        style="@style/Action"
                        android:text="Battery" />

                    <Button
                        android:id="@+id/appSettingsButton"
                        style="@style/Action"
                        android:text="App settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- log -->
            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Activity" />

                    <Button
                        android:id="@+id/refreshButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
